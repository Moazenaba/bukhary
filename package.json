{
  "name": "bukhari-competition-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server.ts scripts/migrate.ts scripts/create-admin.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-server --define:__PRODUCTION_BUILD__=true",
    "start": "node dist-server/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:prod": "node dist-server/scripts/migrate.js",
    "create-admin": "tsx scripts/create-admin.ts",
    "create-admin:prod": "node dist-server/scripts/create-admin.js",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "node -e \"for (const d of ['dist','dist-server']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "backup": "node scripts/backup.mjs",
    "publish:android": "node scripts/publish-android.mjs"
  },
  "dependencies": {
    "@fontsource/cairo": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/tajawal": "5.3.0",
    "@google/genai": "^2.4.0",
    "@tanstack/react-query": "5.104.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "material-symbols": "0.47.5",
    "pg": "^8.23.1",
    "sql.js": "^1.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.27.7",
    "jsdom": "30.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "engines": {
    "node": ">=22"
  }
}
