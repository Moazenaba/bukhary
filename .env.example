# ==============================================================================
# Bukhari Quran Competition Management System - Vercel Environment Variables
# ملف متغيرات البيئة والأسرار (Secrets) لمنصة Vercel
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Auth Configuration (قاعدة بيانات سوبربيز)
# ------------------------------------------------------------------------------
# رابط مشروع Supabase الخاص بك (تلاقيه في: Project Settings -> API -> Project URL)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# مفتاح Anon العام للاتصال من المتصفح (تلاقيه في: Project Settings -> API -> Project API keys -> anon public)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# مفتاح Service Role السري (فقط للخادم/Serverless Functions - لا تضعه مع بادئة VITE)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 2. Google Sheets & Sync Integrations (مزامنة جداول جوجل)
# ------------------------------------------------------------------------------
# معرف شيت جوجل الافتراضي
VITE_GOOGLE_SHEETS_ID="your_google_sheet_id_here"

# رابط الـ Webhook الخاص بالمزامنة السريعة مع جوجل شيت (Google Apps Script Webhook)
VITE_GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/your-script-id/exec"

# ------------------------------------------------------------------------------
# 3. Application & Deployment Settings (إعدادات التطبيق والاستضافة)
# ------------------------------------------------------------------------------
# بيئة التشغيل (production على Vercel)
NODE_ENV="production"
VITE_APP_ENV="production"

# اسم النظام المعروض
VITE_APP_NAME="نظام إدارة مسابقات مسجد الإمام البخاري"

# رابط الاستضافة على Vercel (مثال: https://bukhari-competition.vercel.app)
VITE_APP_URL="https://your-deployment-name.vercel.app"
APP_URL="https://your-deployment-name.vercel.app"

# ------------------------------------------------------------------------------
# 4. Optional AI / Gemini API Keys (اختياري)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
