# ---- Required ----
NODE_ENV=production
# Postgres connection string (Supabase: Project Settings > Database > Connection string).
DATABASE_URL=postgresql://postgres.<project>:<password>@<host>:5432/postgres
# The database certificate is verified. Download Supabase's CA certificate
# (Project Settings > Database > SSL Configuration) and point to it:
DATABASE_CA_CERT_PATH=./certs/supabase-ca.crt
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=

# ---- Optional ----
PORT=3000
# Set when running behind a proxy/load balancer (number of hops, or "true").
TRUST_PROXY=1
ACCESS_TOKEN_TTL=8h
REFRESH_TOKEN_TTL_DAYS=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
LOG_LEVEL=info

# Table extraction from images (OCR). Leave empty to disable the feature.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Only for `npm run create-admin` (first super admin) ----
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Local development only ----
# DATABASE_SSL=disable   # local Postgres without TLS; refused when NODE_ENV=production
# TEST_DATABASE_URL=postgresql://postgres@localhost:55432/bukhari_test

# Optional: every unexpected server error (HTTP 500, unhandled rejection) is POSTed here as JSON,
# e.g. a log relay or an error tracker's ingest URL. Leave empty to only log to stderr.
ERROR_REPORT_URL=
# Optional: release label sent with error reports.
APP_VERSION=

# Backups (npm run backup): folder for dump files, and the full path to pg_dump if it is not on PATH.
BACKUP_DIR=backups
PG_DUMP=
