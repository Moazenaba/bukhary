# ---- Required ----
NODE_ENV=production
# Postgres connection string (Supabase: Project Settings > Database > Connection string).
DATABASE_URL=postgresql://postgres.<project>:<password>@<host>:5432/postgres
# The database certificate is verified. Download Supabase's CA certificate
# (Project Settings > Database > SSL Configuration) and point to it:
DATABASE_CA_CERT_PATH=./certs/supabase-ca.crt
# On Vercel there is no file to point at: paste the certificate text (BEGIN..END) instead.
# DATABASE_CA_CERT=
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=

# ---- Optional ----
PORT=3000
# Database connections per server instance (the Vercel function defaults to 3).
# DATABASE_POOL_MAX=10
# Set when running behind a proxy/load balancer (number of hops, or "true").
TRUST_PROXY=1
# Keep 8h until most phones run Android versionCode 2, then 15m (docs/RELEASE.md).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Rollout switches (docs/RELEASE.md, section 2).
ENFORCE_PASSWORD_CHANGE=true
STRICT_PERMISSION_IDS=false
LEGACY_STAGE_PATCH=true
MIN_ANDROID_VERSION_CODE=0
LOG_LEVEL=info

# Table extraction from images (OCR). Leave empty to disable the feature.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Only for `npm run create-admin` (first super admin) ----
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Local development only ----
# Point DATABASE_URL at a local database. `npm run migrate`, `create-admin` and `backup` refuse a
# non-local database unless you add `-- --remote`. JWT_SECRET is required here too.
# DATABASE_SSL=disable   # local Postgres without TLS; refused when NODE_ENV=production
# TEST_DATABASE_URL=postgresql://postgres@localhost:55432/bukhari_test

# Optional: every unexpected server error (HTTP 500, unhandled rejection) is POSTed here as JSON,
# e.g. a log relay or an error tracker's ingest URL. Leave empty to only log to stderr.
ERROR_REPORT_URL=
# Optional: release label sent with error reports.
APP_VERSION=

# Backups (npm run backup): folder for dump files, and the full path to pg_dump if it is not on PATH.
BACKUP_DIR=backups
PG_DUMP=

# Push notifications (Firebase Cloud Messaging). Without these, notifications stay in-app only.
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Either the JSON itself (or base64 of it), or a path to the downloaded file:
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_PATH=
